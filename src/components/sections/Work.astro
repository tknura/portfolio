---
import SectionLabel from '../SectionLabel.astro';
import FeaturedProject from './FeaturedProject.astro';
import TypeStudy from '../experiments/TypeStudy.astro';
import RhythmStudy from '../experiments/RhythmStudy.astro';
import OrbitStudy from '../experiments/OrbitStudy.astro';
import PointerStudy from '../experiments/PointerStudy.astro';
---

<section id="work" class="work section-pad">
  <SectionLabel index="01" title="THE WORK" note="LESS TALK. MORE PROOF." />
  <div class="section-heading">
    <h2>Okay, but<br />can he <em>build?</em></h2>
    <p>From complex product interfaces<br />to the tiny details you can’t<br />quite put your finger on.</p>
  </div>
  <FeaturedProject />
  <div class="study-grid experiments-grid">
    <TypeStudy />
    <RhythmStudy />
    <OrbitStudy />
    <PointerStudy />
  </div>
</section>
